#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int a[100];
        int sum = 0;

        for (int i = 0; i < n; i++) {
            cin >> a[i];
            sum = sum + a[i];
        }

        int min_pair = a[0] + a[1];

        for (int i = 1; i < n - 1; i++) {
            if (a[i] + a[i + 1] < min_pair) {
                min_pair = a[i] + a[i + 1];
            }
        }

        cout << sum - (min_pair / 2) << endl;
    }

    return 0;
}