#include <iostream>
#include <string>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        string s;
        cin >> s;

        int min_len = 1;
        for (int i = 1; i < n; i++) {
            if (s[i] != s[i - 1]) {
                min_len++;
            }
        }

        if (k >= min_len) {
            cout << "YES" << endl;
        } else {
            cout << "NO" << endl;
        }
    }

    return 0;
}